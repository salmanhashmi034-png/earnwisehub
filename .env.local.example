# ============================================================
# EarnWiseHub – Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# ---- Site URL (no trailing slash) ----
# Required: set to your real production domain
NEXT_PUBLIC_SITE_URL=https://earnwisehub.com

# ---- Contact email ----
# Required: set to your real email address
NEXT_PUBLIC_CONTACT_EMAIL=hello@earnwisehub.com

# ---- Google Analytics 4 ----
# Optional: add your real GA4 Measurement ID (starts with G-)
# Leave blank until you have connected Analytics
NEXT_PUBLIC_GA_ID=

# ---- Google Tag Manager ----
# Optional: add your real GTM container ID (starts with GTM-)
# Leave blank if not using GTM
NEXT_PUBLIC_GTM_ID=

# ---- Google Search Console Verification ----
# Optional: add the meta tag content value from Search Console
# Leave blank until you verify ownership
NEXT_PUBLIC_GSC_VERIFY=

# ---- Google AdSense ----
# Optional: add your publisher ID (format: ca-pub-XXXXXXXXXXXXXXXX)
# Leave blank until your AdSense account is approved
# Only add this AFTER AdSense approval - adding it before may affect approval
NEXT_PUBLIC_ADSENSE_PUB=

# ---- Social Media ----
# Optional: add when accounts are created
NEXT_PUBLIC_TWITTER=
NEXT_PUBLIC_FACEBOOK=
NEXT_PUBLIC_LINKEDIN=
